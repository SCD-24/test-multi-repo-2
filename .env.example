# Analytics API — environment
#
# Copy to .env and adjust. Every value below is the built-in default from
# src/config.ts (CONFIG_DEFAULTS). Invalid values refuse to boot rather than
# degrading silently.

# SSE endpoint of the Telemetry Generator this service ingests from.
# Must match that service's PORT (4001 by default).
GENERATOR_URL=http://localhost:4001/stream

# TCP port this service listens on. The Dashboard's VITE_ANALYTICS_API_URL
# defaults to http://localhost:4002, so changing this means changing that too.
PORT=4002

# Retention horizon of the in-memory ring buffer, in milliseconds (1 hour).
# There is no database: restarting this service discards all history.
RING_WINDOW_MS=3600000

# Standard deviations from the rolling mean before a reading is an Anomaly.
ANOMALY_K=3

# Browser origin allowed to call this API. The Dashboard talks to this service
# directly from the browser, so this must be its exact origin — no trailing
# slash, no path. Use "*" only where the API is not otherwise exposed.
CORS_ORIGIN=http://localhost:5173
